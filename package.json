{
  "name": "chat-hooks-monorepo",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend \"pnpm --filter @chat-hooks/backend dev\" \"pnpm --filter @chat-hooks/frontend dev\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
